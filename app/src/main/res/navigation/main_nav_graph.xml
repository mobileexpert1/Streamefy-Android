<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/splashScreen">
    <fragment
        android:id="@+id/splashScreen"
        android:name="com.streamefy.component.ui.splash.SplashScreen"
        android:label="splashScreen"
        tools:layout="@layout/fragment_splash_screen" />
    <fragment
        android:id="@+id/homefragment"
        android:name="com.streamefy.component.ui.home.HomeFragment"
        android:label="homefragment"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.streamefy.component.ui.login.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_otpFragment"
            app:destination="@id/otpFragment" />
    </fragment>
    <fragment
        android:id="@+id/otpFragment"
        android:name="com.streamefy.component.ui.otp.OtpFragment"
        android:label="OtpFragment"
        tools:layout="@layout/fragment_otp">
        <action
            android:id="@+id/action_otpFragment_to_pinAuthenticationFragment"
            app:destination="@id/pinAuthenticationFragment" />
        <action
            android:id="@+id/action_otpFragment_to_projectfragment"
            app:destination="@id/projectfragment" />
    </fragment>
    <fragment
        android:id="@+id/pinAuthenticationFragment"
        android:name="com.streamefy.component.ui.pin_authentication.PinAuthenticationFragment"
        android:label="PinAuthenticationFragment"
        tools:layout="@layout/fragment_pin_authentication">
        <action
            android:id="@+id/action_pinAuthenticationFragment_to_homefragment"
            app:destination="@id/homefragment" />
    </fragment>
    <fragment
        android:id="@+id/videofragment"
        android:name="com.streamefy.component.ui.video.VideoFragment"
        android:label="videofragment"
        tools:layout="@layout/fragment_video" />
    <fragment
        android:id="@+id/dynamicscreen"
        android:name="com.streamefy.component.ui.dynamicview.DynamicPlayer"
        android:label="dynamicscreen"
        tools:layout="@layout/fragment_dynamic_player" />
    <fragment
        android:id="@+id/projectfragment"
        android:name="com.streamefy.component.ui.projects.EventFragment"
        android:label="projectfragment"
        tools:layout="@layout/fragment_event">
        <action
            android:id="@+id/action_projectfragment_to_pinAuthenticationFragment"
            app:destination="@id/pinAuthenticationFragment" />
    </fragment>
</navigation>