<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/loginParent"
        >
        <ImageView
            android:id="@+id/ivbackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@string/app_name"
            app:layout_constraintEnd_toEndOf="@+id/constraintLayout"
            app:layout_constraintStart_toStartOf="@+id/constraintLayout"
            app:layout_constraintTop_toTopOf="parent"
            />
        <ImageView
            android:id="@+id/ivApplogo"
            android:layout_width="@dimen/_230sdp"
            android:layout_height="@dimen/_55sdp"
            android:layout_marginTop="@dimen/_40sdp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="@+id/constraintLayout"
            app:layout_constraintStart_toStartOf="@+id/constraintLayout"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_logo_ori" />
<!--        android:backgroundTint="@color/layout_color_theme"-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="@dimen/_180sdp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:background="@drawable/bg_round_corners"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="@dimen/_13sdp"
            android:paddingVertical="@dimen/_15sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivApplogo">

            <EditText
                android:id="@+id/etFullname"
                style="@style/filson_14_whiteTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/inputfield_selector"
                android:completionThreshold="1"
                android:drawableStart="@drawable/ic_user"
                android:drawablePadding="@dimen/_10sdp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone"
                android:hint="Email"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress|textNoSuggestions"
                android:maxLength="25"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/_5sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text=""
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="@drawable/inputfield_selector"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etFullname">

                <com.hbb20.CountryCodePicker
                    android:id="@+id/ccCode"
                    style="@style/filson_14_whiteTV"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="0dp"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:layout_marginVertical="@dimen/_3sdp"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:gravity="center"
                    app:circularflow_viewCenter="@dimen/_4sdp"
                    app:ccpDialog_background="@color/white"
                    app:ccp_arrowColor="@color/black"
                    app:ccp_contentColor="@color/black"
                    android:background="@color/transparent"
                    app:ccp_defaultNameCode="in"
                    android:imeOptions="actionDone"
                    app:ccp_showArrow="true"
                    app:ccp_arrowSize="@dimen/_9sdp"
                    app:ccp_defaultPhoneCode="91"
                    app:ccp_showFlag="false"
                    app:ccp_showNameCode="false"
                    app:ccp_showPhoneCode="true"
                    app:ccp_autoFormatNumber="true"
                    android:clickable="true"
                    app:ccp_autoDetectCountry="true"
                    app:ccp_textSize="@dimen/_7sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/lineview"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:background="@color/light_gray"
                    app:layout_constraintStart_toEndOf="@+id/ccCode"
                    app:layout_constraintTop_toTopOf="@+id/ccCode"
                    app:layout_constraintBottom_toBottomOf="@+id/ccCode"/>
                <EditText
                    android:id="@+id/etPhoneNumber"
                    style="@style/filson_14_whiteTV"
                    android:paddingEnd="@dimen/_6sdp"
                    android:layout_width="0dp"
                    android:layout_marginVertical="@dimen/_3sdp"
                    android:background="@color/white"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/phone_number"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:gravity="center_vertical"
                    android:minEms="4"
                    android:maxLines="1"
                    android:maxLength="16"
                    android:paddingVertical="@dimen/_5sdp"
                    android:paddingStart="@dimen/_2sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:singleLine="true"
                    android:text=""
                    android:textSize="@dimen/_7sdp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/lineview"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="TextFields" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvGetOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/ic_button_selector"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_3sdp"
                android:text="@string/get_otp"
                android:textColor="@color/input_field_color_selector"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llNumber" />


        </androidx.constraintlayout.widget.ConstraintLayout>


        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_15sdp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_round_corners"
            android:backgroundTint="@color/white"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/textView"
                style="@style/filson_14_whiteTV"
                android:paddingBottom="@dimen/_2sdp"
                android:text="@string/powered_by"
                android:textColor="@color/black"
                android:textSize="9sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_width="@dimen/_50sdp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_6sdp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitXY"

                android:src="@drawable/ic_powerby"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView" />

            <!--            android:src="@drawable/ic_powerby"-->
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>