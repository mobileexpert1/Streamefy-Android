<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_120sdp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginHorizontal="@dimen/_3sdp"
    android:descendantFocusability="afterDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="@dimen/_3sdp">


    <LinearLayout
        android:id="@+id/clThumb"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_110sdp"
        android:layout_marginBottom="@dimen/_5sdp"
        android:padding="@dimen/_1sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent"
            android:backgroundTint="@color/black"
            app:cardCornerRadius="@dimen/_7sdp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clEvent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                tools:background="@drawable/selected_item">


                <ImageView
                    android:id="@+id/ivThumb"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="@dimen/_1sdp"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toTopOf="@+id/clBottom"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/home_theme" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/black"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/tvAddEvent"
                        style="@style/filson_regular_21_whiteTV"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:paddingVertical="@dimen/_11sdp"
                        android:singleLine="true"
                        android:text="Add Event"
                        android:textSize="@dimen/_12sdp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvTitle"
                        style="@style/filson_19_whiteTV"
                        android:layout_width="match_parent"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:paddingVertical="@dimen/_2sdp"
                        android:singleLine="true"
                        android:text="Mehendi ceremony"
                        app:layout_constraintBottom_toTopOf="@+id/view"
                        app:layout_constraintStart_toStartOf="parent" />

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:background="#56616161"
                        app:layout_constraintBottom_toTopOf="@+id/tvSubtitle" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        style="@style/filson_regular_12_whiteTV"
                        android:layout_width="0dp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:ellipsize="end"
                        android:fontFamily="@font/filsonpro_regular"
                        android:maxLines="1"
                        android:paddingVertical="@dimen/_2sdp"
                        android:paddingStart="@dimen/_5sdp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_6sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvProjectCount"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:text="Friday 22 March, 2024" />

                    <TextView
                        android:id="@+id/tvProjectCount"
                        style="@style/filson_regular_12_whiteTV"
                        android:drawableStart="@drawable/ic_project_video"
                        android:drawablePadding="@dimen/_2sdp"
                        android:fontFamily="@font/filsonpro_regular"
                        android:maxLines="2"
                        android:paddingHorizontal="@dimen/_5sdp"
                        android:paddingVertical="@dimen/_2sdp"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_6sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/tvSubtitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="48" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <TextView
        android:id="@+id/tvResetPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:drawableStart="@drawable/ic_reset_pin_svg"
        android:drawablePadding="@dimen/_5sdp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="@font/filsonpro_bold"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_3sdp"
        android:text="Reset PIN"
        android:textColor="@color/white"
        android:gravity="center"
        android:textSize="15sp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clThumb" />
</androidx.constraintlayout.widget.ConstraintLayout>