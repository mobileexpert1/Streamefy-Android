<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/_5sdp"
        app:cardCornerRadius="@dimen/_10sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingVertical="@dimen/_15sdp">


            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivClose"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                android:src="@drawable/ic_exit_cross_selector"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMessage"
                style="@style/filson_regular_21_whiteTV"
                android:layout_marginStart="@dimen/_7sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:paddingHorizontal="@dimen/_5sdp"
                android:paddingVertical="@dimen/_2sdp"
                android:text="@string/exit_message"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivClose" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMessage">


                <TextView
                    android:id="@+id/tvContinue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_4sdp"
                    android:text="Cancel"
                    android:fontFamily="@font/filsonpro_bold"
                    android:textColor="@color/input_field_color_selector"
                    android:focusable="true"
                    android:textSize="@dimen/_7sdp"
                    android:textAllCaps="true"
                    android:focusableInTouchMode="true"
                    android:background="@drawable/ic_button_selector"
                    android:layout_gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                     />

                <TextView
                    android:id="@+id/tvExit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/ic_button_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:paddingVertical="@dimen/_4sdp"
                    android:fontFamily="@font/filsonpro_bold"
                    android:textSize="@dimen/_7sdp"
                    android:text="EXIT NOW"
                    android:textAllCaps="true"
                    android:textColor="@color/input_field_color_selector"
                    android:layout_marginStart="@dimen/_3sdp"
                    app:layout_constraintTop_toTopOf="@+id/tvContinue"
                    app:layout_constraintBottom_toBottomOf="@+id/tvContinue"
                    app:layout_constraintStart_toEndOf="@+id/tvContinue"
                    />
                <ImageView

                    style="@style/filson_regular_12_whiteTV"
                    android:layout_width="@dimen/_42sdp"
                    android:paddingVertical="@dimen/_3sdp"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:focusable="true"
                    android:visibility="gone"
                    android:focusableInTouchMode="true"
                    android:src="@drawable/ic_exist_selector"
                    app:layout_constraintTop_toTopOf="@+id/tvContinue"
                    app:layout_constraintBottom_toBottomOf="@+id/tvContinue"
                    app:layout_constraintStart_toEndOf="@+id/tvContinue"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</layout>